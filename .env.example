# ===========================================================================
# College Carpool — environment configuration (copy to .env and fill in)
# Never commit the real .env file.
# ===========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---- Database (PostGIS) ----
# Format: postgis://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgis://carpool:carpool@db:5432/carpool

# ---- Redis (cache, channels layer, live-location state) ----
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
# Lifetimes in minutes (access short-lived) and days (refresh long-lived).
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# ---- College verification ----
# The single college this MVP serves. Used to validate college email domains.
COLLEGE_DOMAIN=college.edu

# ---- Email (OTP delivery) ----
# Leave EMAIL_HOST blank in dev to print OTP emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=College Carpool <no-reply@college.edu>

# ---- OTP behaviour ----
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Maps (mobile builds; also used for any server-side geocoding later) ----
MAPS_API_KEY=

# ---- Expo push notifications ----
EXPO_ACCESS_TOKEN=

# ---- Observability ----
SENTRY_DSN=

# ---- Tracking / live location ----
# How often the driver device should emit location updates (seconds).
TRACKING_UPDATE_INTERVAL_SECONDS=4
# How long the last-known location stays "live" in Redis before going stale.
TRACKING_LOCATION_TTL_SECONDS=120
# Minimum spacing between persisted location snapshots (seconds).
TRACKING_SNAPSHOT_INTERVAL_SECONDS=30
# How long a share link stays valid after creation (hours).
SHARE_SESSION_TTL_HOURS=6
# Public base for shareable tracking links: <base>/<token>.
SHARE_LINK_BASE_URL=https://carpool.example.app/track

# ---- Rewards (configurable point values) ----
POINTS_DRIVER_COMPLETE=15
POINTS_PASSENGER_COMPLETE=10
